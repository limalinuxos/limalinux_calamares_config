pkgname=limalinux_calamares_config
_pkgname=limalinux_calamares_config
pkgver=26.04
pkgrel=1
pkgdesc="Configuración, branding y selección de software nativa de LimaLinux"
arch=('any')
url="https://github.com/limalinuxos/${_pkgname}"
license=('GPL3')
depends=('calamares-limalinux') 
options=(!strip !emptydirs)

package() {
 
    cd "$srcdir"

    # 1. Config from (/etc/calamares/...)
 
    if [ -d "${startdir}/etc" ]; then
        install -d "${pkgdir}/etc"
        cp -ra "${startdir}/etc/"* "${pkgdir}/etc/"
    fi

    # 2.  (/usr/...)
    
    if [ -d "${startdir}/usr" ]; then
        install -d "${pkgdir}/usr"
        cp -ra "${startdir}/usr/"* "${pkgdir}/usr/"
    fi

    # 3. Allow permissions
    if [ -d "${pkgdir}/usr/local/bin" ]; then
        echo "Ajustando permisos para scripts en /usr/local/bin..."
        chmod +x "${pkgdir}/usr/local/bin/"*
    fi
    
    # 4. 
    if [ -d "${pkgdir}/usr/lib/calamares/modules" ]; then
        echo "Ajustando permisos para módulos de Calamares..."
        chmod -R 755 "${pkgdir}/usr/lib/calamares/modules/"*
    fi
}
